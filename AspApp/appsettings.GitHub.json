{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "AspApp.Controllers.NewUserController": "Information"
    }
  },
  "AllowedHosts": "*",

  "Turnstile": {
    "Enabled": false,
    "SecretKey": "your-secret-key"
  },

  "Kafka": {
    "BootstrapServer": "kafka:9092",
    "LogTopic": "log",
    "EmailTopic": "email"
  },

  "Postgres": {
    "ConnectionString": {
      "Identity": "Host=Postgres;Database=IdentityDb;Username=postgres;Password=Password;"
    }
  },
  
  "MongoDb": {
    "ConnectionString": "mongodb://mongodb:27017",
    "UserDbName": "Users_Db",
    "ProfileCollectionName": "Profile"
  }
  
}
